# PXC-LeadHunter ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve anahtarlarınızı doldurun:
#   copy .env.example .env

OPENAI_API_KEY=sk-your-openai-api-key-here
SERPER_API_KEY=your-serper-api-key-here

# İsteğe bağlı ayarlar
OPENAI_MODEL=gpt-4o-mini
SEARCH_COUNTRY=tr
SEARCH_LANGUAGE=tr
REQUEST_TIMEOUT=20
MAX_PAGE_CHARS=8000
